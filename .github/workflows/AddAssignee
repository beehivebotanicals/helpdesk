name: Issue assignment  
#this is from Pozil/auto-assign action

on:
    issues:
        types: [opened]

jobs:
    auto-assign:
        runs-on: ubuntu-latest
        permissions:
            issues: write
        steps:
            - name: 'Auto-assign issue'
              uses: pozil/auto-assign-issue@v4
              with:
                  assignees:  ${{ vars.DEFAULT_ISSUE_ASSIGNEE }}  # the person to assign to, this is a repo variable, go to settings, secrets etc.
                  numOfAssignee: 1
                  allowSelfAssign: true
                  abortIfPreviousAssignees: true    # skip if already assigned
